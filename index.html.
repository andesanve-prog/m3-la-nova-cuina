     if(editingKitchen){
       cocinaId=presetKitchenId;
       const {error}=await db.from('cocinas').update(obj).eq('id',cocinaId);
       if(error){alert('No se pudo actualizar la cocina: '+error.message);return;}
       await registrarHistorial(cocinaId,'Cocina modificada','Se actualizaron los datos de la ficha.');
     } else {
       const {data:kitchen,error}=await db.from('cocinas').insert(obj).select('id').single();
       if(error){alert('No se pudo guardar la cocina: '+error.message);return;}
       cocinaId=kitchen.id;
       await registrarHistorial(cocinaId,'Cocina creada','Se creó una nueva ficha de trabajo.');
     }

     // El montaje se agenda desde la misma ficha de la cocina.
     const agendarMontaje=document.querySelector('input[name="agendar_montaje"]')?.checked;
     if(agendarMontaje){
       const agendaInstaller=obj.instalador_id || (isAdmin ? null : currentUser.id);
       if(!agendaInstaller){
         alert('La cocina se guardó, pero no se pudo agendar el montaje porque falta seleccionar el instalador.');
       } else if(!obj.fecha_montaje){
         alert('La cocina se guardó, pero no se pudo agendar el montaje porque falta la fecha.');
       } else {
         const agendaPayload={
           cocina_id:cocinaId,
           tipo_trabajo:'Montaje',
           instalador_id:agendaInstaller,
           vehiculo_id:obj.vehiculo_id||null,
           fecha:obj.fecha_montaje,
           hora_inicio:obj.hora_entrada||null,
           hora_fin:obj.hora_salida||null,
           observaciones:'Montaje de nueva cocina '+(obj.numero||'')
         };
         const {data:existingAgenda,error:findAgendaError}=await db.from('agenda')
           .select('id').eq('cocina_id',cocinaId).eq('tipo_trabajo','Montaje').order('created_at',{ascending:false}).limit(1);
         if(findAgendaError){
           alert('La cocina se guardó, pero no se pudo comprobar la agenda: '+findAgendaError.message);
         } else if(existingAgenda?.length){
           const {error:agendaUpdateError}=await db.from('agenda').update(agendaPayload).eq('id',existingAgenda[0].id);
           if(agendaUpdateError) alert('La cocina se guardó, pero no se pudo actualizar la agenda: '+agendaUpdateError.message);
           else await registrarHistorial(cocinaId,'Agenda actualizada',`Montaje programado para ${agendaPayload.fecha} ${agendaPayload.hora_inicio||''}`);
         } else {
           const {error:agendaInsertError}=await db.from('agenda').insert(agendaPayload);
           if(agendaInsertError) alert('La cocina se guardó, pero no se pudo agendar el montaje: '+agendaInsertError.message);
           else await registrarHistorial(cocinaId,'Montaje agendado',`Montaje programado para ${agendaPayload.fecha} ${agendaPayload.hora_inicio||''}`);
         }
       }
     }
     if(trabajoFotos.length){
       for(const file of trabajoFotos){
         const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,'_');
         const path=cocinaId+'/'+Date.now()+'_'+safeName;
         const up=await db.storage.from('trabajos').upload(path,file,{upsert:false});
         if(up.error){alert('La cocina se guardó, pero no se pudo subir la foto del trabajo "'+file.name+'". Crea el bucket de Storage "trabajos" y sus políticas en Supabase.');break;}
         const {data:urlData}=db.storage.from('trabajos').getPublicUrl(path);
         const trabajoUser=await db.auth.getUser();
         const trabajoUserId=trabajoUser.data.user?.id;
         const {error:photoError}=await db.from('fotos_trabajo').insert({cocina_id:cocinaId,archivo:urlData.publicUrl,descripcion:file.name,subido_por:trabajoUserId});
         if(photoError){alert('La foto del trabajo se subió, pero no se pudo registrar: '+photoError.message);break;}
         await registrarHistorial(cocinaId,'Foto de trabajo añadida',file.name);
       }
     }
     if(planos.length){
       for(const file of planos){
         const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,'_');
         const path=cocinaId+'/'+Date.now()+'_'+safeName;
         const up=await db.storage.from('planos').upload(path,file,{upsert:false});
         if(up.error){alert('La cocina se guardó, pero no se pudo subir el plano "'+file.name+'". Comprueba el bucket de Storage "planos" y sus políticas en Supabase.');break;}
         const {data:urlData}=db.storage.from('planos').getPublicUrl(path);
         const planUser=await db.auth.getUser();
         const planUserId=planUser.data.user?.id;
         const {error:planError}=await db.from('planos_cocinas').insert({cocina_id:cocinaId,archivo:urlData.publicUrl,nombre:file.name,subido_por:planUserId});
         if(planError){alert('El plano se subió, pero no se pudo registrar: '+planError.message);break;}
         await registrarHistorial(cocinaId,'Plano añadido',file.name);
       }
     }
     let incidenciaId=null;
     if(incidenciaTitulo || incidenciaDescripcion || incidenciaMaterial || fotos.length){
       const userRes=await db.auth.getUser();
       const creadaPor=userRes.data.user?.id;
       const inc={cocina_id:cocinaId,titulo:incidenciaTitulo||'Incidencia con fotos',descripcion:((incidenciaDescripcion?incidenciaDescripcion:'') + (incidenciaMaterial?'\nMaterial relacionado: '+incidenciaMaterial:'')).trim() || null,estado:'abierta',creada_por:creadaPor};
       const {data:incData,error:incError}=await db.from('incidencias').insert(inc).select('id').single();
       if(incError){alert('La cocina se guardó, pero no se pudo crear la incidencia: '+incError.message);showModule(name);return;}
       incidenciaId=incData.id;
       if(fotos.length){
         for(const file of fotos){
           const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,'_');
           const path=cocinaId+'/'+Date.now()+'_'+safeName;
           const up=await db.storage.from('incidencias').upload(path,file,{upsert:false});
           if(up.error){alert('La cocina y la incidencia se guardaron, pero no se pudo subir la foto "'+file.name+'". Crea el bucket de Storage "incidencias" y sus políticas en Supabase.');break;}
           const {data:urlData}=db.storage.from('incidencias').getPublicUrl(path);
           const incidenciaPhotoUser=await db.auth.getUser();
           const incidenciaPhotoUserId=incidenciaPhotoUser.data.user?.id;
           const {error:photoError}=await db.from('fotos_incidencias').insert({incidencia_id:incidenciaId,archivo:urlData.publicUrl,descripcion:file.name,subido_por:incidenciaPhotoUserId});
           if(photoError){alert('La foto se subió, pero no se pudo registrar: '+photoError.message);break;}
         }
       }
     }
      alert(editingKitchen?'Cocina actualizada correctamente.':'Cocina guardada correctamente.');
     showKitchenDetail(cocinaId);

   } else if(name==='tiendas'){
     if(!isAdmin){alert('Solo el administrador puede crear tiendas.');return;}
     const tiendaPayload={
       nombre:String(document.querySelector('[name="nombre"]')?.value||'').trim(),
       direccion:String(document.querySelector('[name="direccion"]')?.value||'').trim()||null,
       telefono:String(document.querySelector('[name="telefono"]')?.value||'').trim()||null,
       email:String(document.querySelector('[name="email"]')?.value||'').trim()||null,
       activo:(document.querySelector('[name="activo"]')?.value||'true')!=='false',
       usuario_tienda:String(document.querySelector('[name="usuario_tienda"]')?.value||'').trim(),
       password_tienda:String(document.querySelector('[name="password_tienda"]')?.value||'')
     };
     if(!tiendaPayload.nombre||!tiendaPayload.usuario_tienda||!tiendaPayload.password_tienda){alert('Completa nombre, usuario y contraseña de la tienda.');return;}
     if(tiendaPayload.password_tienda.length<6){alert('La contraseña debe tener al menos 6 caracteres.');return;}
     const {data:{session}}=await db.auth.getSession();
     if(!session?.access_token){
       alert('La sesión del administrador ha caducado. Cierra sesión y vuelve a entrar.');
       return;
     }

     const {data:fnData,error:fnError}=await db.functions.invoke('crear-ususario-tienda',{
       body:tiendaPayload
     });

     if(fnError){
       let detalle=fnError.message||String(fnError);
       if(fnError.context){
         try{
           const r=await fnError.context;
           const t=await r.text();
           if(t) detalle += ' — '+t;
         }catch(_){}
       }
       alert('No se pudo crear la tienda y su usuario: '+detalle);
       return;
     }
     alert('Tienda creada correctamente. Usuario: '+tiendaPayload.usuario_tienda);
     showModule('tiendas'); return;

     const {error}=await db.from(table).insert(obj);
     if(error){alert('No se pudo guardar: '+error.message);return;}
     alert('Guardado correctamente.');
     showModule(name);
   }
   } catch(err) {
     console.error(err);
     alert('No se pudo guardar: '+(err?.message||err));
   } finally {
     saveKitchenBtn.disabled=false;
     saveKitchenBtn.textContent='Guardar';
   }
 };
}
document.querySelectorAll('.menu button').forEach(btn=>btn.addEventListener('click',()=>showModule(btn.dataset.module)));
document.querySelectorAll('.quick button').forEach(btn=>btn.addEventListener('click',()=>{const t=(btn.textContent||'').toLowerCase();if(t.includes('nuevo trabajo'))nuevoTrabajo();else if(t.includes('nueva incidencia'))showForm('incidencias');else if(t.includes('gestionar instaladores')&&isAdmin)showModule('instaladores');}));

function escapeHtml(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}

document.getElementById('loginBtn').onclick=async()=>{
 msg.textContent='Comprobando…';
 const email=document.getElementById('email').value.trim(),password=document.getElementById('password').value;
 if(!email||!password){msg.textContent='Introduce email y contraseña.';return}
 const loginValue = String(email || '').trim();
  // Los instaladores entran con su nombre de usuario.
  // Internamente Supabase Auth utiliza el correo técnico generado al crearlos.
  const authEmail = loginValue.includes('@')
    ? loginValue
    : `${loginValue.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9._-]/g, "")}@m3lanovacuina.local`;
  const {data,error}=await db.auth.signInWithPassword({email:authEmail,password});
 if(error){msg.textContent='No se pudo iniciar sesión: '+error.message;return}
 msg.textContent='';await enter(data.session);
};
document.getElementById('logout').onclick=async()=>{await db.auth.signOut();await enter(null)};
db.auth.getSession().then(({data})=>enter(data.session));
</script>

<script>
async function actualizarNotificacionSolicitudes(){
  try{
    if(typeof isAdmin!=='undefined' && !isAdmin) return;
    if(typeof db==='undefined') return;
    const {count,error}=await db.from('solicitudes_trabajo')
      .select('id',{count:'exact',head:true})
      .eq('estado','pendiente');
    if(error) return;
    const badge=document.getElementById('solicitudes-badge');
    if(!badge) return;
    const n=count||0;
    badge.textContent=n;
    badge.style.display=n>0?'inline-flex':'none';
  }catch(e){}
}
document.addEventListener('DOMContentLoaded',()=>{
  actualizarNotificacionSolicitudes();
  window.__solicitudesNotifTimer=setInterval(actualizarNotificacionSolicitudes,15000);
});
</script>


<script>
/* Fallback directo para el botón Solicitudes */
function delegatedSolicitudesClick(e){
  const el=e.target.closest('button');
  if(!el) return;
  if((el.textContent||'').toLowerCase().includes('solicitudes')){
    e.preventDefault();
    e.stopPropagation();
    if(typeof showModule==='function') showModule('solicitudes');
  }
}
document.addEventListener('click',delegatedSolicitudesClick,true);
</script>


<script>
(function(){
  function closeMobileMenu(){
    var side=document.querySelector('.side'); var back=document.getElementById('mobileMenuBackdrop');
    if(side) side.classList.remove('mobileOpen'); if(back) back.classList.remove('show');
  }
  document.addEventListener('DOMContentLoaded',function(){
    var btn=document.getElementById('mobileMenuBtn'); var side=document.querySelector('.side'); var back=document.getElementById('mobileMenuBackdrop');
    if(!btn||!side||!back) return;
    btn.addEventListener('click',function(e){e.stopPropagation(); side.classList.toggle('mobileOpen'); back.classList.toggle('show');});
    back.addEventListener('click',closeMobileMenu);
    side.querySelectorAll('.menu button').forEach(function(b){b.addEventListener('click',closeMobileMenu);});
  });
})();
</script>
