async function enter(session){
 if(!session){loginPage.classList.remove('hidden');app.classList.add('hidden');currentUser=null;currentRole='';isAdmin=false;return}
 currentUser=session.user;
 const {data:perfil,error:perfilError}=await db.from('profiles').select('nombre,rol,activo,tienda_id').eq('id',session.user.id).maybeSingle();
 if(perfilError){msg.textContent='Error al comprobar el perfil: '+perfilError.message;return}
 if(!perfil || perfil.activo===false || !['administrador','instalador','tienda'].includes(perfil.rol)){
   await db.auth.signOut();msg.textContent='Este usuario no tiene permisos para entrar.';return;
 }
 currentRole=perfil.rol;
 currentTiendaId=perfil.tienda_id||null;
 isStore=currentRole==='tienda';
 const {data:adminCheck,error:adminError}=await db.rpc('es_administrador');
 isAdmin=!adminError && adminCheck===true;
 if(currentRole==='administrador') isAdmin=true;
 let nombre=perfil.nombre || session.user.user_metadata?.nombre || session.user.email || (isAdmin?'Administrador':'Instalador');
 loginPage.classList.add('hidden');app.classList.remove('hidden');
 document.getElementById('userInfo').textContent=nombre+' · '+(isAdmin?'Administrador':(isStore?'Tienda':'Instalador'));
 aplicarPermisosInterfaz();
 await cargarPanel();
}

function aplicarPermisosInterfaz(){
 const adminOnly=['instaladores','tiendas','comerciales','cobros','solicitudes','vehiculos'];
 const storeOnly=['solicitar','misproyectos','missolicitudes'];
 document.querySelectorAll('.menu button').forEach(btn=>{
   if(adminOnly.includes(btn.dataset.module)) btn.classList.toggle('hidden',!isAdmin);
   if(storeOnly.includes(btn.dataset.module)) btn.classList.toggle('hidden',!isStore);
   if(btn.dataset.module==='dashboard') btn.classList.toggle('hidden',isStore);
   if(btn.dataset.module==='agenda') btn.classList.toggle('hidden',isStore);
   if(btn.dataset.module==='incidencias') btn.classList.toggle('hidden',isStore);
   if(btn.dataset.module==='historial') btn.classList.toggle('hidden',isStore);
 });
}

function estadoTexto(e){return ({abierta:'Abierta',en_proceso:'En proceso',pedido:'Pedido',solucionada:'Solucionada',cerrada:'Cerrada'})[e]||e||'—'}
function estadoClase(e){return (e==='abierta'||!e)?'badge danger':'badge'}

async function cargarPanel(){
 if(isStore){ await showModule('misproyectos'); return; }
 const [cocinas, incidencias, perfiles, clientes, tiendas]=await Promise.all([
   db.from('cocinas').select('id,numero,estado,cliente_id,instalador_id'),
   db.from('incidencias').select('id,cocina_id,titulo,estado,asignada_a,created_at').order('created_at',{ascending:false}).limit(20),
   db.from('pedidos').select('id,estado'),
   db.from('profiles').select('id,nombre'),
   db.from('clientes').select('id,nombre'),
   db.from('tiendas').select('id,nombre')
 ]);
 const errors=[cocinas,incidencias,perfiles,clientes,tiendas].filter(x=>x.error);
 if(errors.length){console.error(errors.map(x=>x.error));}
 const cs=cocinas.data||[], inc=incidencias.data||[], ps=perfiles.data||[];
 document.getElementById('statCocinas').textContent=cs.filter(x=>x.estado!=='terminada').length;
 document.getElementById('statProceso').textContent=cs.filter(x=>x.estado==='en_proceso').length;
 document.getElementById('statIncidencias').textContent=inc.filter(x=>!['solucionada','cerrada'].includes(x.estado)).length;
 document.getElementById('statPedidos').textContent=ped.filter(x=>x.estado==='por_pedir'||x.estado==='pedido').length;
 const cmap=new Map(cs.map(x=>[x.id,x]));
 const pmap=new Map(ps.map(x=>[x.id,x.nombre]));
 const wrap=document.getElementById('incidentRows');
 const pending=inc.filter(x=>!['solucionada','cerrada'].includes(x.estado)).slice(0,8);
 if(!pending.length){wrap.innerHTML='<div class="row"><div style="grid-column:1/-1;color:#999">No hay incidencias pendientes.</div></div>';return;}
 wrap.innerHTML=pending.map(i=>{
   const c=cmap.get(i.cocina_id);
   const asignado=i.asignada_a?pmap.get(i.asignada_a):null;
   return `<div class="row"><div><b>${escapeHtml(c?.numero||'Sin cocina')}</b></div><div>${escapeHtml(i.titulo||'Sin título')}</div><div>${escapeHtml(asignado||'Sin asignar')}</div><div><span class="${estadoClase(i.estado)}">${escapeHtml(asignado?' '+estadoTexto(i.estado):'Sin asignar')}</span></div></div>`;
 }).join('');
}

