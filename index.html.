async function aceptarSolicitud(id, options={}){
 if(!isAdmin){alert('Solo el administrador puede aceptar solicitudes.');return false;}
 const {data:r,error}=await db.from('solicitudes_trabajo').select('*').eq('id',id).single();
 if(error||!r){alert('No se pudo cargar la solicitud: '+(error?.message||'No encontrada'));return false;}
 if(r.estado!=='pendiente'){alert('Esta solicitud ya fue gestionada.');return false;}

 let clienteId=null;
 if(r.cocina_id){
   const {data:k}=await db.from('cocinas').select('id,cliente_id').eq('id',r.cocina_id).single();
   clienteId=k?.cliente_id||null;
 }
 if(!clienteId){
   const cliente={nombre:r.cliente_nombre,telefono:r.cliente_telefono,email:r.cliente_email,direccion:r.cliente_direccion};
   Object.keys(cliente).forEach(k=>{if(cliente[k]==null||cliente[k]==='')delete cliente[k];});
   const cr=await db.from('clientes').insert(cliente).select('id').single();
   if(cr.error){alert('No se pudo crear el cliente: '+cr.error.message);return false;}
   clienteId=cr.data.id;
 }

 const fecha=options.fecha ?? r.fecha_deseada ?? null;
 const instaladorId=options.instalador_id ?? null;

 let cocinaId=r.cocina_id||null;

 if(!cocinaId){
   const year=(fecha||'').slice(0,4)||String(new Date().getFullYear());
   const nums=await db.from('cocinas').select('numero');
   if(nums.error){alert('No se pudo generar el número: '+nums.error.message);return false;}
   let max=0;
   const re=new RegExp('^COC-'+year+'-(\\\\d{4})$');
   for(const row of (nums.data||[])){
     const m=String(row.numero||'').match(re);
     if(m)max=Math.max(max,Number(m[1]));
   }

   const baseKitchen={
     cliente_id:clienteId,
     tienda_id:r.tienda_id,
     comercial_id:r.comercial_id||null,
     instalador_id:instaladorId,
     fecha_montaje:fecha,
     estado:r.tipo_trabajo==='Incidencia'?'incidencia':'pendiente',
     progreso:0,
     observaciones:r.observaciones||null
   };

   // El número de cocina es único. Si otra operación acaba de usar el siguiente
   // número, volvemos a consultar y reintentamos con el siguiente disponible.
   let kr=null;
   let numero=max+1;
   for(let intento=0; intento<5; intento++){
     const kitchen={...baseKitchen,numero:'COC-'+year+'-'+String(numero).padStart(4,'0')};
     kr=await db.from('cocinas').insert(kitchen).select('id').single();
     if(!kr.error) break;
     const msg=String(kr.error.message||'');
     if(!/duplicate key|unique constraint|cocinas_numero_key/i.test(msg)) break;
     const fresh=await db.from('cocinas').select('numero');
     if(fresh.error) break;
     let freshMax=0;
     for(const row of (fresh.data||[])){
       const m=String(row.numero||'').match(re);
       if(m) freshMax=Math.max(freshMax,Number(m[1]));
     }
     numero=freshMax+1;
   }
   if(!kr || kr.error){alert('No se pudo crear la ficha: '+(kr?.error?.message||'Error desconocido'));return false;}
   cocinaId=kr.data.id;
 }else{
   const updates={};
   if(fecha!==undefined) updates.fecha_montaje=fecha;
   if(instaladorId!==undefined) updates.instalador_id=instaladorId;
   if(Object.keys(updates).length){
     const ku=await db.from('cocinas').update(updates).eq('id',cocinaId);
     if(ku.error){alert('La solicitud no se pudo asignar a la cocina: '+ku.error.message);return false;}
   }
 }

 if(r.tipo_trabajo==='Incidencia'){
   const inc=await db.from('incidencias')
     .insert({
       cocina_id:cocinaId,
       titulo:'Incidencia solicitada por tienda',
       descripcion:r.observaciones||null,
       estado:'abierta',
       creada_por:currentUser.id
     })
     .select('id').single();
   if(inc.error){
     alert('La ficha se creó, pero no se pudo crear la incidencia: '+inc.error.message);
     return false;
   }
 }

 if(fecha || instaladorId){
   const {data:existingAgenda,error:agendaFindError}=await db.from('agenda')
     .select('id')
     .eq('cocina_id',cocinaId)
     .eq('tipo_trabajo',r.tipo_trabajo)
     .limit(1)
     .maybeSingle();

   if(agendaFindError){
     console.warn('No se pudo consultar la agenda:',agendaFindError.message);
   }else{
     const agendaPayload={
       cocina_id:cocinaId,
       tipo_trabajo:r.tipo_trabajo,
       instalador_id:instaladorId,
       fecha:fecha,
       observaciones:r.observaciones||null
     };

     let ar;
     if(existingAgenda?.id){
       ar=await db.from('agenda').update(agendaPayload).eq('id',existingAgenda.id);
     }else{
       ar=await db.from('agenda').insert(agendaPayload);
     }

     if(ar.error){
       alert('La ficha se creó, pero no se pudo crear/actualizar la agenda: '+ar.error.message);
       return false;
     }
   }
 }

 const {error:uerr}=await db.from('solicitudes_trabajo')
   .update({estado:'aceptada',cocina_id:cocinaId,fecha_deseada:fecha})
   .eq('id',id);

 if(uerr){
   alert('La ficha se creó, pero no se pudo actualizar la solicitud: '+uerr.message);
   return false;
 }

 await registrarHistorial(
   cocinaId,
   'Solicitud aceptada',
   `Solicitud de tienda aceptada${fecha?` para ${fecha}`:''}${instaladorId?' con instalador asignado':''}.`
 );

 alert('Solicitud aceptada, instalador asignado y agenda actualizada.');
 showModule('solicitudes');
 return true;
}

