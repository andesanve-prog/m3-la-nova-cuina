function parseHojaMontaje(text){
 const out={trabajos:[],electro:[],motivoTrabajos:'',motivoElectro:'',falta:'',materialFaltante:'',materialM3:'',observaciones:'',entrada:'',salida:'',acabado:''};
 if(!text) return out;
 const lines=String(text).split(/\n/);
 for(const line of lines){
  const i=line.indexOf(':'); if(i<0) continue;
  const key=line.slice(0,i).trim().toLowerCase(), val=line.slice(i+1).trim();
  if(key==='hora entrada') out.entrada=val;
  else if(key==='hora salida') out.salida=val;
  else if(key==='trabajos realizados') out.trabajos=val && val!=='Ninguno marcado'?val.split(',').map(x=>x.trim()).filter(Boolean):[];
  else if(key==='motivo trabajos no realizados') out.motivoTrabajos=val==='—'?'':val;
  else if(key==='electrodomésticos') out.electro=val && val!=='Ninguno marcado'?val.split(',').map(x=>x.trim()).filter(Boolean):[];
  else if(key==='motivo electrodomésticos no instalados') out.motivoElectro=val==='—'?'':val;
  else if(key==='falta por montar') out.falta=val==='—'?'':val;
  else if(key==='material faltante') out.materialFaltante=val==='—'?'':val;
  else if(key==='material pendiente m3') out.materialM3=val==='—'?'':val;
  else if(key==='observaciones') out.observaciones=val==='—'?'':val;
  else if(key==='montaje acabado') out.acabado=val;
 }
 return out;
}
function tiempoMontaje(entrada,salida){
 if(!entrada||!salida) return '';
 const [h1,m1]=entrada.split(':').map(Number), [h2,m2]=salida.split(':').map(Number);
 if([h1,m1,h2,m2].some(Number.isNaN)) return '';
 let mins=(h2*60+m2)-(h1*60+m1); if(mins<0) mins+=1440;
 return `${Math.floor(mins/60)} h ${String(mins%60).padStart(2,'0')} min`;
}
