const db=supabase.createClient('https://ocmsitrhejhwujqffxso.supabase.co','sb_publishable_rDR1zhj8AVLIBk1ue54kUg_uaAS59Mk');
const loginPage=document.getElementById('loginPage'), app=document.getElementById('app'), msg=document.getElementById('msg');

let currentUser=null;
let currentRole='';
