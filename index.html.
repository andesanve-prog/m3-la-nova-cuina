async function eliminarCocina(id){
 if(!isAdmin){alert('Solo el administrador puede eliminar cocinas.');return;}
 const {data:k,error:kError}=await db.from('cocinas').select('id,numero').eq('id',id).single();
 if(kError){alert('No se pudo cargar la cocina: '+kError.message);return;}
 if(!confirm('¿Seguro que quieres eliminar la cocina '+(k?.numero||'')+'?\n\nSe eliminarán también sus tareas, incidencias, pedidos e historial asociados. Las fotos almacenadas también se intentarán eliminar.'))return;
 try{
  const [incRes,workRes]=await Promise.all([
   db.from('fotos_incidencias').select('id,archivo,incidencia_id').in('incidencia_id',(await db.from('incidencias').select('id').eq('cocina_id',id)).data?.map(x=>x.id)||[]),
   db.from('fotos_trabajo').select('id,archivo').eq('cocina_id',id)
  ]);
  const incPhotoPaths=(incRes.data||[]).map(x=>storagePathFromUrl(x.archivo,'incidencias')).filter(Boolean);
  const workPhotoPaths=(workRes.data||[]).map(x=>storagePathFromUrl(x.archivo,'trabajos')).filter(Boolean);
  if(incPhotoPaths.length) await db.storage.from('incidencias').remove(incPhotoPaths);
  if(workPhotoPaths.length) await db.storage.from('trabajos').remove(workPhotoPaths);
  const {error}=await db.from('cocinas').delete().eq('id',id);
  if(error){alert('No se pudo eliminar la cocina: '+error.message);return;}
  alert('Cocina eliminada correctamente.');
  showModule('cocinas');
 }catch(err){alert('No se pudo eliminar la cocina: '+(err?.message||err));}
}
function storagePathFromUrl(url,bucket){
 try{
  const marker='/storage/v1/object/public/'+bucket+'/';
  const i=String(url||'').indexOf(marker);
  return i>=0?decodeURIComponent(String(url).slice(i+marker.length)):'';
 }catch(e){return '';}
}
